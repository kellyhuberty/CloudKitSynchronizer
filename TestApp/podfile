use_frameworks!
target 'CloudKitSynchronizerAppPod' do
 	platform :ios, '16.0'
	pod 'GRDB.swift', :git => 'https://github.com/groue/GRDB.swift.git', :tag => 'v7.8.0'
	pod 'CloudKitSynchronizer', :path => '../'
end

target 'CloudKitSynchronizerTests' do
	platform :ios, '16.0'
	pod 'GRDB.swift', :git => 'https://github.com/groue/GRDB.swift.git', :tag => 'v7.8.0'
	pod 'CloudKitSynchronizer', :path => '../'
end

post_install do |installer|
	# Some pods (e.g. GRDB.swift) declare deployment targets older than Xcode supports.
	installer.pods_project.targets.each do |target|
		target.build_configurations.each do |config|
			config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'
		end
	end
end
